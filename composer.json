{
    "name": "emmanuelsiziba/zb-laravel-smilepay",
    "description": "ZB Laravel package for SmilePay Payment Gateway integration (ZB Bank Zimbabwe)",
    "type": "library",
    "keywords": [
        "laravel",
        "smilepay",
        "payment gateway",
        "zb bank",
        "zimbabwe",
        "ecocash",
        "innbucks",
        "omari",
        "smilecash",
        "payment"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Emmanuel Siziba",
            "email": "emmasiziba@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0",
        "phpunit/phpunit": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Emmanuelsiziba\\SmilePay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emmanuelsiziba\\SmilePay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Emmanuelsiziba\\SmilePay\\SmilePayServiceProvider"
            ],
            "aliases": {
                "SmilePay": "Emmanuelsiziba\\SmilePay\\Facades\\SmilePay"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
